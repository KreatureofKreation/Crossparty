#
# Bug-finding and security checks, plus the plan's naming rule: no single
# letters outside short loops. Every warning fails CI.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  performance-*,
  readability-identifier-length,
  readability-misleading-indentation,
  readability-redundant-*,
  -bugprone-easily-swappable-parameters
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|tests)/.*'
# Skip code generated by Qt's moc, which the build writes under *_autogen/.
ExcludeHeaderFilterRegex: '.*_autogen/.*'
CheckOptions:
  readability-identifier-length.MinimumVariableNameLength: 3
  readability-identifier-length.MinimumParameterNameLength: 3
  readability-identifier-length.MinimumLoopCounterNameLength: 1
  readability-identifier-length.IgnoredParameterNames: '^(argc|argv)$'
